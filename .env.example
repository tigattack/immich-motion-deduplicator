IMMICH_ROOT_DIR=/path/to/your/immich/library
IMMICH_API_URL=http://your-immich-host:2283/api
IMMICH_API_KEY=your_api_key
MOTION_CANDIDATES_CSV=motion_candidates.csv
MOTION_CANDIDATES_WITH_IDS_CSV=motion_candidates_with_ids.csv

# Path for scan-live results (input to delete for live photo flow)
LIVE_CANDIDATES_CSV=live_candidates.csv
# Server-side absolute path prefix to strip from Immich originalPath
# e.g. if Immich stores files at /usr/src/app/upload/... and you mount /usr/src/app/upload at IMMICH_ROOT_DIR:
IMMICH_SERVER_PATH_PREFIX=/usr/src/app/upload
